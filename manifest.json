{
  "manifest_version": 3,
  "name": "DARKee",
  "version": "1.20.8",
  "description": "Thème sombre réglable pour Google, Wikipédia et tout site que vous choisissez. Aucune connexion réseau, aucune donnée envoyée.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "geolocation"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.google.fr/*",
    "*://*.wikipedia.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DARKee",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png"
    }
  },
  "commands": {
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Activer / désactiver le thème sombre sur ce site (mémorisé)"
    },
    "toggle-all": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Activer / désactiver le thème sombre partout"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.fr/*",
        "*://*.wikipedia.org/*"
      ],
      "js": [
        "sites.js",
        "recolor.js",
        "content.js",
        "cookies.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://docs.google.com/*"
      ],
      "js": [
        "canvas-images.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
